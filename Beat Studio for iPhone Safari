<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0a0a12" />
  <title>Beat Studio</title>
  <style>
    :root { --bg:#0a0a12; --panel:#151522; --panel2:#1c1c2d; --line:#303047; --text:#f6f5ff; --muted:#aaa9be; --accent:#9b6bff; --accent2:#35d6bb; --danger:#ff5e76; }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100vh; background:radial-gradient(circle at 15% 0%,#211b42 0,transparent 32rem),var(--bg); color:var(--text); font:14px/1.4 Inter, ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif; }
    button,input { font:inherit; } button { color:inherit; cursor:pointer; }
    .app { max-width:1180px; margin:auto; min-height:100vh; display:grid; grid-template-columns:250px 1fr; }
    aside { border-right:1px solid var(--line); padding:24px 16px; background:rgba(12,12,21,.82); }
    .brand { display:flex; gap:10px; align-items:center; padding:0 8px 26px; font-size:18px; font-weight:800; letter-spacing:.04em; }
    .logo { width:34px; height:34px; display:grid; place-items:center; border-radius:10px; background:linear-gradient(135deg,var(--accent),#e26cff); }
    .sub { color:var(--muted); font-size:11px; font-weight:600; margin-top:1px; letter-spacing:.02em; }
    .new { width:100%; border:0; border-radius:10px; background:var(--accent); padding:11px; font-weight:750; box-shadow:0 8px 26px #7144d655; }
    nav { margin-top:22px; display:grid; gap:6px; } nav button { background:transparent; border:0; text-align:left; border-radius:9px; padding:10px 12px; color:var(--muted); } nav button.active,nav button:hover { background:var(--panel2); color:var(--text); }
    .projects { margin-top:28px; color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.12em; padding:0 10px; } #projectList { margin-top:9px; display:grid; gap:5px; }
    .project-item { border:0; width:100%; border-radius:8px; background:transparent; text-align:left; color:var(--text); padding:9px 10px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; } .project-item.selected { background:#282541; }
    main { min-width:0; display:flex; flex-direction:column; } header { height:72px; display:flex; align-items:center; gap:12px; padding:0 26px; border-bottom:1px solid var(--line); } .title-wrap { flex:1; min-width:0; } #projectName { border:0; outline:0; background:transparent; color:var(--text); font-size:17px; font-weight:700; width:100%; } .crumb { color:var(--muted); font-size:12px; } .export { border:0; border-radius:9px; background:var(--accent2); color:#06251f; padding:9px 13px; font-weight:800; }
    .workspace { display:grid; grid-template-columns:1fr 284px; flex:1; min-height:0; } .studio { padding:24px 26px; min-width:0; } .transport { display:flex; align-items:center; gap:10px; background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:12px; } .transport button { border:1px solid var(--line); background:var(--panel2); border-radius:8px; min-width:38px; height:36px; } .transport .record { background:var(--danger); border-color:transparent; } #time { margin-left:4px; font-variant-numeric:tabular-nums; color:#deddf0; min-width:76px; } .tempo { margin-left:auto; color:var(--muted); } .tempo input { width:56px; text-align:center; background:#0f0f19; border:1px solid var(--line); color:var(--text); padding:6px; border-radius:7px; }
    .trackbar { display:flex; align-items:center; justify-content:space-between; margin:24px 0 12px; } .trackbar h2 { margin:0; font-size:14px; } .add { border:0; border-radius:8px; background:#2b2744; padding:8px 11px; font-weight:700; } #tracks { display:grid; gap:10px; } .track { display:grid; grid-template-columns:36px minmax(110px,160px) 1fr 62px; align-items:center; gap:12px; background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:11px; } .track button { border:0; border-radius:7px; background:#303047; height:31px; } .track .mute.active { background:var(--accent); } .track-name { font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; } .meter { height:31px; border-radius:7px; overflow:hidden; background:repeating-linear-gradient(90deg,#222236 0 12px,#1a1a2a 12px 15px); } .meter > i { display:block; height:100%; width:0; background:linear-gradient(90deg,var(--accent),var(--accent2)); transition:width .1s; } .volume { width:100%; accent-color:var(--accent); } .empty { padding:38px 18px; text-align:center; border:1px dashed #45435f; border-radius:14px; color:var(--muted); } .empty strong { display:block; color:var(--text); margin-bottom:6px; }
    .side { border-left:1px solid var(--line); padding:24px 16px; background:rgba(12,12,21,.7); } .side h3 { font-size:13px; margin:0 0 12px; } .panel { margin-bottom:18px; border:1px solid var(--line); border-radius:12px; background:var(--panel); padding:13px; } .panel p { margin:0; color:var(--muted); font-size:13px; } .ai { width:100%; margin-top:12px; border:0; padding:9px; border-radius:8px; background:linear-gradient(90deg,#825dff,#d45dff); font-weight:800; } .mix-row { display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid #29293b; } .mix-row:last-child { border:0; } .mix-row input { width:58px; background:#0e0e17; border:1px solid var(--line); border-radius:7px; color:var(--text); padding:5px; }
    dialog { width:min(430px,calc(100% - 32px)); color:var(--text); border:1px solid #44425e; background:#181725; border-radius:16px; padding:0; box-shadow:0 24px 70px #000a; } dialog::backdrop { background:#0009; } .modal { padding:20px; } .modal h2 { margin:0 0 16px; font-size:18px; } .modal label { display:grid; gap:6px; color:var(--muted); margin-bottom:14px; } .modal input { padding:10px; color:var(--text); border:1px solid var(--line); background:#0d0d16; border-radius:8px; } .actions { display:flex; justify-content:flex-end; gap:8px; margin-top:18px; } .actions button { border:0; border-radius:8px; padding:9px 12px; background:#303047; } .actions .primary { background:var(--accent); } .export-options { display:grid; gap:10px; } .format { text-align:left; border:1px solid var(--line); background:#222133; padding:12px; border-radius:10px; } .format b,.format small { display:block; } .format small { color:var(--muted); margin-top:3px; } .toast { position:fixed; bottom:22px; left:50%; transform:translateX(-50%) translateY(100px); background:#ebeafd; color:#141320; padding:10px 14px; border-radius:10px; font-weight:700; transition:.25s; } .toast.show { transform:translateX(-50%) translateY(0); }
    @media (max-width:780px) { .app { grid-template-columns:1fr; } aside { display:none; } .workspace { grid-template-columns:1fr; } .side { border-left:0; border-top:1px solid var(--line); } header { padding:0 16px; } .studio { padding:16px; } .track { grid-template-columns:34px 1fr 60px; } .meter { display:none; } }
  </style>
</head>
<body>
  <div class="app"><aside><div class="brand"><span class="logo">♫</span><div>BEAT STUDIO<div class="sub">Mobile Music Production</div></div></div><button class="new" id="newProject">＋ New Project</button><nav><button class="active">▣ Projects</button><button id="openAddTrack">＋ Add Track</button><button id="openPlugins">⌁ Plugins</button></nav><div class="projects">Your projects</div><div id="projectList"></div></aside><main><header><div class="title-wrap"><div class="crumb">Projects / <span id="crumb">Untitled</span></div><input id="projectName" value="Untitled" aria-label="Project name" /></div><button class="export" id="openExport">Export</button></header><div class="workspace"><section class="studio"><div class="transport"><button id="play" aria-label="Play">▶</button><button class="record" id="record" aria-label="Record">●</button><span id="time">00:00:00</span><span class="tempo">BPM <input id="bpm" type="number" min="40" max="240" value="120" /></span></div><div class="trackbar"><h2>Tracks</h2><button class="add" id="addTrack">＋ Add Track</button></div><div id="tracks"></div></section><aside class="side"><div class="panel"><h3>✨ AI Producer</h3><p id="suggestion">Add a track, then ask for a production idea.</p><button class="ai" id="aiProducer">Get suggestion</button></div><div class="panel"><h3>Mix</h3><div class="mix-row"><span>Master</span><input id="master" type="number" min="-60" max="12" value="0" /> dB</div><div class="mix-row"><span>Pan</span><input id="pan" type="number" min="-100" max="100" value="0" /></div></div><div class="panel"><h3>Master</h3><p>Light limiter enabled for a cleaner preview.</p></div></aside></div></main></div>
  <dialog id="projectDialog"><form method="dialog" class="modal"><h2>New Project</h2><label>Project name<input id="newProjectName" placeholder="My new beat" maxlength="48" autofocus /></label><div class="actions"><button value="cancel">Cancel</button><button class="primary" id="createProject" value="default">Create</button></div></form></dialog><dialog id="trackDialog"><form method="dialog" class="modal"><h2>Add Track</h2><label>Track name<input id="trackName" placeholder="e.g. Drum kit" maxlength="48" autofocus /></label><div class="actions"><button value="cancel">Cancel</button><button class="primary" id="createTrack" value="default">Add track</button></div></form></dialog><dialog id="exportDialog"><div class="modal"><h2>Export Project</h2><div class="export-options"><button class="format" data-format="WAV"><b>WAV Export</b><small>Uncompressed, highest quality</small></button><button class="format" data-format="M4A"><b>M4A Export</b><small>Compressed, share-friendly</small></button></div><div class="actions"><button id="closeExport">Close</button></div></div></dialog><dialog id="pluginDialog"><div class="modal"><h2>Plugins</h2><p style="color:#aaa9be">No plugins are loaded. Add tracks first, then expand this panel with your audio effects.</p><div class="actions"><button id="closePlugins">Close</button></div></div></dialog><div class="toast" id="toast"></div>
  <script>
    const $=s=>document.querySelector(s),tracksEl=$('#tracks');let tracks=JSON.parse(localStorage.getItem('beat-studio-tracks')||'[]'),projects=JSON.parse(localStorage.getItem('beat-studio-projects')||'["Untitled"]'),seconds=0,ticker,playing=false,recording=false;
    function save(){localStorage.setItem('beat-studio-tracks',JSON.stringify(tracks));localStorage.setItem('beat-studio-projects',JSON.stringify(projects))}function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2200)}function escapeHtml(s){const d=document.createElement('div');d.textContent=s;return d.innerHTML}function renderProjects(){$('#projectList').innerHTML=projects.map(p=>`<button class="project-item ${p===$('#projectName').value?'selected':''}" data-project="${escapeHtml(p)}">${escapeHtml(p)}</button>`).join('');document.querySelectorAll('.project-item').forEach(b=>b.onclick=()=>{$('#projectName').value=b.dataset.project;$('#crumb').textContent=b.dataset.project;renderProjects()})}function renderTracks(){if(!tracks.length){tracksEl.innerHTML='<div class="empty"><strong>No tracks yet</strong>Add an empty track, record from your microphone, or import audio.</div>';return}tracksEl.innerHTML=tracks.map((t,i)=>`<div class="track"><button class="mute ${t.muted?'active':''}" data-mute="${i}">M</button><span class="track-name">${escapeHtml(t.name)}</span><div class="meter"><i style="width:${playing?30+(i*17)%55:0}%"></i></div><input class="volume" data-volume="${i}" type="range" min="0" max="100" value="${t.volume}" /></div>`).join('');document.querySelectorAll('[data-mute]').forEach(b=>b.onclick=()=>{tracks[b.dataset.mute].muted=!tracks[b.dataset.mute].muted;save();renderTracks()});document.querySelectorAll('[data-volume]').forEach(i=>i.oninput=()=>{tracks[i.dataset.volume].volume=+i.value;save()})}function updateTime(){seconds++;const h=String(Math.floor(seconds/3600)).padStart(2,'0'),m=String(Math.floor(seconds%3600/60)).padStart(2,'0'),s=String(seconds%60).padStart(2,'0');$('#time').textContent=`${h}:${m}:${s}`;renderTracks()}
    $('#play').onclick=()=>{playing=!playing;$('#play').textContent=playing?'❚❚':'▶';if(playing)ticker=setInterval(updateTime,1000);else clearInterval(ticker);renderTracks()};$('#record').onclick=()=>{recording=!recording;$('#record').style.boxShadow=recording?'0 0 0 4px #ff5e7655':'none';toast(recording?'Recording armed — microphone access would be requested in a full audio build.':'Recording stopped.')};$('#newProject').onclick=()=>$('#projectDialog').showModal();$('#createProject').onclick=()=>{const n=$('#newProjectName').value.trim()||'Untitled';if(!projects.includes(n))projects.push(n);$('#projectName').value=n;$('#crumb').textContent=n;$('#newProjectName').value='';save();renderProjects();toast(`Created “${n}”`)};$('#projectName').onchange=()=>{$('#crumb').textContent=$('#projectName').value||'Untitled';if(!projects.includes($('#projectName').value))projects.push($('#projectName').value);save();renderProjects()};function showTrack(){$('#trackDialog').showModal()}$('#addTrack').onclick=showTrack;$('#openAddTrack').onclick=showTrack;$('#createTrack').onclick=()=>{const n=$('#trackName').value.trim()||`Track ${tracks.length+1}`;tracks.push({name:n,volume:75,muted:false});$('#trackName').value='';save();renderTracks();toast(`${n} added`)};$('#openExport').onclick=()=>$('#exportDialog').showModal();$('#closeExport').onclick=()=>$('#exportDialog').close();document.querySelectorAll('[data-format]').forEach(b=>b.onclick=()=>{$('#exportDialog').close();toast(`${b.dataset.format} export prepared for “${$('#projectName').value}”.`)});$('#openPlugins').onclick=()=>$('#pluginDialog').showModal();$('#closePlugins').onclick=()=>$('#pluginDialog').close();$('#aiProducer').onclick=()=>{const a=['Try a punchy kick on beats 1 and 3, with a snare on 2 and 4.','Layer a warm pad beneath your melody and automate its filter over eight bars.','Keep the bass simple: follow the root notes and leave space around the kick.','Add a short clap on the off-beat, then lower its level for movement.'];$('#suggestion').textContent=a[Math.floor(Math.random()*a.length)]};renderProjects();renderTracks();
  </script>
</body>
</html>
